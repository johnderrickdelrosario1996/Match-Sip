rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all direct client access
    match /{document=**} {
      allow read, write: if false;
    }

    // Court reservations collection: direct client modification forbidden
    match /bookings/{bookingId} {
      allow read, write: if false;
    }

    // Atomic court slot locks
    match /courtSlotLocks/{lockId} {
      allow read, write: if false;
    }

    // Security audit and visitor analytics
    match /visitorAnalytics/{logId} {
      allow read, write: if false;
    }
  }
}
